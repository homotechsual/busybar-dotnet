<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Busy.Bar</RootNamespace>
    <AssemblyName>BusyBar</AssemblyName>
    <PackageId>BusyBar</PackageId>
    <Version>0.1.0</Version>
    <Authors>MJCO</Authors>
    <Description>A typed .NET client for the BUSY Bar HTTP API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/homotechsual/busybar-dotnet</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
